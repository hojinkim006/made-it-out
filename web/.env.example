# Copy to .env.local and fill in.

# Gemini is not set here: its key is an Edge Function secret in Supabase
# (Dashboard -> Edge Functions -> Secrets -> GEMINI_API_KEY).

# Supabase: Project Settings -> API. The publishable key is meant to be public.
# Never put the secret key in this file: anything starting with VITE_ ships to the browser.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
